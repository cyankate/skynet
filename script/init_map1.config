thread = 8
logger = "entry/loggerS"
logservice = "snlua"
logpath = "./log/map1/"
loggroup = "debug"
harbor = 0
node_name = "map1"
cluster_mode = "split"
cluster = "./script/cluster/clustername.lua"
debug_port = 8891
start = "main"
bootstrap = "snlua bootstrap"
luaservice = "./script/?.lua;./service/?.lua;./script/entry/?.lua;./script/tools/?.lua"
lualoader = "lualib/loader.lua"
preload = "./script/preload.lua"
cpath = "./cservice/?.so"
snax = "./examples/?.lua;"
enablessl = true
certfile = "./cert/server.crt"
keyfile = "./cert/server.key"
max_connection = 8192
mongo_host = "127.0.0.1"
mongo_port = 27017
mongo_db = skynet
mongo_authdb = admin
