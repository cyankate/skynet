thread = 8
logger = "entry/loggerS"
logservice = "snlua"
logpath = "./log/game/"
loggroup = "debug"
harbor = 0
node_name = "game"
cluster_mode = "split"
cluster = "./script/cluster/clustername.lua"
start = "main"
bootstrap = "snlua bootstrap"
luaservice = "./script/?.lua;./service/?.lua;./script/entry/?.lua;./script/tools/?.lua"
lualoader = "lualib/loader.lua"
preload = "./script/preload.lua"
cpath = "./cservice/?.so"
snax = "./examples/?.lua;"
enablessl = true
certfile = "./cert/server.crt"
keyfile = "./cert/server.key"
max_connection = 8192
mongo_host = "127.0.0.1"
mongo_port = 27017
mongo_db = skynet
mongo_authdb = admin
gate_count = 2
gate_port = 8888
-- 双门走 nginx：门听 127.0.0.1:19001/19002，客户端连 8000。单进程开发用 init.config 直连 8888
gate_behind_lb = 1
